# ---- Supabase (required) ----------------------------------------------------
# Browser-safe values from your Supabase project (Settings -> API).
# NEVER put a service-role or secret key in a VITE_ variable.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# A legacy project may use the anon key instead:
# VITE_SUPABASE_ANON_KEY=

# ---- Map defaults (South Chennai) ------------------------------------------
VITE_MAP_LATITUDE=12.95
VITE_MAP_LONGITUDE=80.17
VITE_MAP_ZOOM=11

# ---- Open-data enrichment --------------------------------------------------
# Open-Meteo needs no key. OpenAQ requires a free key (https://openaq.org).
# Leave OpenAQ blank to simply hide the air-quality panel.
VITE_OPENAQ_API_KEY=
# Identifies the app to Nominatim per its usage policy (required).
VITE_NOMINATIM_APP=CivicSync-SouthChennai/1.0 (civic hackathon demo)
VITE_NOMINATIM_EMAIL=
